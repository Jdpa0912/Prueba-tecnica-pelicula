# Base de datos usada por Docker Compose.
POSTGRES_DB=peliculas
POSTGRES_USER=peliculas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Genera un valor único y aleatorio de al menos 32 caracteres para cada entorno.
JWT_SECRET=reemplaza-esto-por-un-secreto-seguro-de-al-menos-32-caracteres

# Token de lectura de la API de TMDb (opcional para levantar los contenedores,
# necesario para que funcione la búsqueda de películas).
TMDB_API_TOKEN=
TMDB_LANGUAGE=es-ES

# URL que el navegador utilizará para comunicarse con la API.
VITE_API_URL=http://localhost:8000/api/v1
