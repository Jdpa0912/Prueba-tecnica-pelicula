# Cadena de conexión de PostgreSQL. Completa los valores en tu archivo .env local.
DATABASE_URL=

# Secreto aleatorio de al menos 32 caracteres para firmar los JWT.
JWT_SECRET=

# Token de lectura de TMDb (API Read Access Token). Créalo en
# https://www.themoviedb.org/settings/api y no lo expongas en el frontend.
TMDB_API_TOKEN=

# Idioma preferido para los títulos y sinopsis de TMDb.
TMDB_LANGUAGE=es-ES
